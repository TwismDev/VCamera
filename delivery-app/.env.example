# Supabase — these two are safe to ship in a mobile bundle; the database is
# protected by row level security, not by hiding this key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Google Maps. The best source of live-traffic ETAs, and the only way the map
# renders on Android. Enable "Routes API", "Maps SDK for Android" and
# "Maps SDK for iOS" on the key.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Mapbox. Optional alternative used for ETAs when there is no Google key — its
# driving-traffic profile also accounts for current conditions.
EXPO_PUBLIC_MAPBOX_TOKEN=
