# ---------------------------------------------------------------------------
# Client configuration. EXPO_PUBLIC_* values are embedded in the app bundle,
# so only ever put publishable keys here.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# How often the driver app reports its position while a delivery is running.
EXPO_PUBLIC_TRACKING_INTERVAL_SECONDS=20
EXPO_PUBLIC_TRACKING_DISTANCE_METERS=50

# ---------------------------------------------------------------------------
# Native build-time keys. Needed for Google Maps tiles on Android, and for the
# Apple/Google map view on iOS. Not required for the keyless fallback.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

# Application identifiers used when generating the native projects.
ANDROID_PACKAGE=com.example.deliverytracker
IOS_BUNDLE_ID=com.example.deliverytracker
EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# Server-side only. Set with `supabase secrets set ...`, never in the app.
# If GOOGLE_MAPS_SERVER_KEY is absent the edge functions fall back to the free
# OpenStreetMap/OSRM providers, which work without a key but have no live
# traffic data.
# ---------------------------------------------------------------------------
# GOOGLE_MAPS_SERVER_KEY=
